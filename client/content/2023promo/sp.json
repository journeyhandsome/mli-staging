    "qa": [
        {
            "question": "P2. ¿Cómo puedo recibir esta beca?", 
            "answer": [
                "Puedes solicitar tu beca a través de nuestro formulario de solicitud en línea utilizando el código \"SCHOLAR2023\". Pagarás solo $150 por la tarifa de procesamiento (no reembolsable) y recibirás un crédito de $50, si no eres estudiante F1. El primer día de clases en MLI, realizarás tu pago restante, menos $50."
            ],
            "btn": "/images/home/image1.png",
