  "optional": {
    "title": "SEVIS Fee (I901)",
    "form":[
      {
        "type": "radio",
        "name": "optional",
        "label": "Do you want MLI to pay the SEVIS fee and include your I901 (SEVIS fee receipt) with your I-20 package?",
        "new_label": "Apply for a student visa",
        "icon": "credit-card-fill",
        "callback":"optionalFee",
        "costs":{"Yes_(SEVIS_fee:_$350.00_+_credit_card_fee:_$15.00)":"365","No_(You,_the_student,_will_pay_the_SEVIS_fee_by_yourself":"0"},
        "selection": [
          {
            "value": "Yes_(SEVIS_fee:_$350.00_+_credit_card_fee:_$15.00)",
            "label": "Yes (SEVIS fee: $350.00 + Credit card fee: $15.00)"
          },
          {
            "value": "No_(You,_the_student,_will_pay_the_SEVIS_fee_by_yourself",
            "label": "No (You, the student, will pay the SEVIS fee by yourself.)"
          }
        ]
      }
    ]
  },
