  "processingFee": {
    "title": "Fees",
    "new_title": "I-20 Payment",
    "form": [
      {
        "field": "payViaStripe"
      }
    ],
    "subtitle": "Application Regulations",
    "details": [
      {
        "title": "Leaving a Course:",
        "description": [
          "It is possible for you to leave a course at any time during the term. When leaving a course, it is necessary to submit a written statement that states your intention to leave the course. In addition, MLI reserves the right to withdraw you from a course, such as if you engage in inappropriate behavior, if you do not maintain the required rate of attendance, or if you do not meet the academic standards of a course."
        ]
      },
      {
        "title": "Right to Cancellation:",
        "description": [
          "You have the right to cancel this enrollment and obtain a refund of charges paid through attendance at the first class session, or the seventh day after enrollment date, whichever is later. \"Cancellation\" is defined as: any voluntary change in enrollment or request for refund prior to enrollment."
        ]
      },
      {
        "title": "Refund Policy:",
        "description": [
          "If the student wishes to cancel, he or she must notify the school on the first day of attendance or the seventh day after enrollment (whichever date comes later).",
          "If the cancellation deadline has passed, the refund policy for students who have completed 60 percent or less of the period of attendance shall be a pro rata refund, minus a $150 non-refundable processing fee, a $120 shipping and handling fee (if applicable) and the STRF fee.",
          "Under California law, if the student withdraws after taking more than 60% of the class hours paid for, no refund will be issued."
        ]
      }
    ],
    "additional_form": [
      {
        "type": "checkbox",
        "name": "agree_terms",
        "label": "I agree to the above terms as listed in the \"Application Regulations.\"",
        "isRequired": true
      }
    ]
  },
  "confirmation": "Confirm Register",
